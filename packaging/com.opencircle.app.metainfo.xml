<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, the AppImage catalog). Add a <release> on top for each new version. -->
<component type="desktop-application">
  <id>com.opencircle.app</id>
  <name>OpenCircle</name>
  <summary>Circle anything on your screen to search, read, translate or ask about it</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.ameralreyahi">
    <name>OpenCircle contributors</name>
  </developer>
  <description>
    <p>
      OpenCircle brings Circle to Search to the desktop. Press a shortcut, the screen freezes, and you circle or
      drag over anything to search it, read it, translate it in place, or ask an AI about it.
    </p>
    <p>
      A second mode snips and marks up screenshots: an area, a window, the full screen or a long scrolling
      page, with arrows, text, blur and numbered steps, then copy, save or pin.
    </p>
    <p>
      It never uploads your screen on its own: search and AI open in your own browser, only when you choose
      them, and translation runs on your computer. No account and no telemetry.
    </p>
  </description>
  <launchable type="desktop-id">com.opencircle.app.desktop</launchable>
  <provides>
    <binary>opencircle</binary>
  </provides>
  <url type="homepage">https://github.com/AmerAlreyahi/OpenCircle</url>
  <url type="bugtracker">https://github.com/AmerAlreyahi/OpenCircle/issues</url>
  <categories>
    <category>Utility</category>
    <category>Graphics</category>
  </categories>
  <keywords>
    <keyword>screenshot</keyword>
    <keyword>search</keyword>
    <keyword>translate</keyword>
    <keyword>OCR</keyword>
    <keyword>Lens</keyword>
  </keywords>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
